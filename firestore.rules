rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return (
        (isSignedIn() && request.auth.token.email == 'v44120621@gmail.com') ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))) ||
        (incoming().adminPasskey == 'Shoplink2026' || incoming().adminPasskey == 'shoplink2026')
      );
    }

    // Public showcase products
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && (
        isAdmin() || 
        incoming().adminPasskey == 'Shoplink2026' || 
        incoming().adminPasskey == 'shoplink2026' ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['clicks']) &&
         incoming().clicks is number &&
         incoming().clicks == existing().clicks + 1)
      );
      allow delete: if isValidId(productId);
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny other collections
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
