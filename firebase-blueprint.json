{
  "entities": {
    "Product": {
      "title": "Affiliate Product",
      "description": "Represents an affiliate product promoted on the showcase website.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product document ID."
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180,
          "description": "Product display name."
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Detailed product description and specs."
        },
        "price": {
          "type": "number",
          "description": "Current or discounted deal price."
        },
        "originalPrice": {
          "type": "number",
          "description": "Original MSRP or strike-through price."
        },
        "currency": {
          "type": "string",
          "maxLength": 8,
          "description": "Currency symbol (e.g. ₹, $, €)."
        },
        "platform": {
          "type": "string",
          "maxLength": 50,
          "description": "Marketplace platform name (e.g. Amazon, Flipkart, Meesho, Myntra)."
        },
        "affiliateLink": {
          "type": "string",
          "maxLength": 2048,
          "description": "Affiliate URL redirecting users to the marketplace."
        },
        "imageBase64": {
          "type": "string",
          "maxLength": 900000,
          "description": "Optimized high-quality base64 image data URI."
        },
        "category": {
          "type": "string",
          "maxLength": 60,
          "description": "Product category."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether to highlight product on the homepage."
        },
        "tags": {
          "type": "array",
          "description": "List of search tags (max 8)."
        },
        "clicks": {
          "type": "number",
          "description": "Number of times users clicked the buy button."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document last updated timestamp."
        },
        "creatorEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Email of the admin who uploaded the product."
        }
      },
      "required": ["title", "platform", "affiliateLink", "imageBase64", "price"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator authorized to manage products.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Admin user UID."
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email address."
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "System role."
        }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Affiliate products collection publicly readable by any user, writable only by the admin."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators record."
    }
  }
}
